# Copia este archivo como .env (no lo subas a GitHub) y rellena tus valores.

# Supabase: URL del proyecto y clave de servicio (Settings → API → service_role). Nunca la pongas en la app.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=

# RDT-Client en el NAS
RDT_URL=http://IP-DEL-NAS:6500
RDT_USER=
RDT_PASS=
RDT_CAT_MOVIES=Peliculas
RDT_CAT_SERIES=Series

# Opcional: para convertir el id de TMDB en el de IMDb (lo necesitan los addons)
TMDB_API_KEY=

# Addons en los que busca el modo automático (* = todos)
ADDON_HINTS=torrentio,comet,peerflix,pelis,stremthru,torz,mediafusion,knightcrawler,jackettio,annatar,orion

# Cada cuántos segundos mira la cola y cuántas veces reintenta una solicitud
INTERVAL=30
MAX_INTENTOS=3

# Minutos sin avanzar para marcar una descarga como «Atascada» en la app
ATASCO_MIN=15
# Aviso al móvil cuando termina una descarga (0 = desactivado)
AVISOS_DESCARGAS=1
