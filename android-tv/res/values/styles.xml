<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TemaCineMoodTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- El mismo fondo que el modo oscuro de la web: al abrir no hay destello blanco ni negro -->
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:colorBackground">@color/fondo</item>
    </style>
    <color name="fondo">#121413</color>
</resources>
